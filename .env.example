# 이 파일을 .env 로 복사한 뒤 실제 값을 채워 넣으세요.
# .env 는 .gitignore 에 포함되어 있어 git 에 커밋되지 않습니다.
# 실제 시크릿 값을 이 파일(.env.example)에 절대 쓰지 마세요 — 저장소는 공개입니다.

# BotFather에서 발급받은 봇 토큰 (Cloud Run에서는 Secret Manager 사용)
BOT_TOKEN=여기에_재발급받은_토큰

# GitHub Pages 에 배포된 Mini App 폼 주소 (HTTPS 필수)
FORM_URL=https://woorrr.github.io/ixi_bot/

# 전화번호 HMAC 키 — `openssl rand -base64 32` 로 생성
TEL_HASH_KEY=

# 전화번호 AES-256-GCM 키 — `openssl rand -base64 32` 로 생성 (HMAC 키와 다른 값)
TEL_ENC_KEY=

# 관리자 1:1 chat ID (정수) — 봇과 1:1 대화에서 /whoami 로 확인
ADMIN_CHAT_ID=

# 운영 대상 그룹방 ID (음수 정수) — 그룹방에서 /whoami 로 확인
GROUP_CHAT_ID=

# webhook 운영 시에만 설정 (미설정이면 long polling 으로 기동 — 로컬 개발용)
# WEBHOOK_URL=https://ixibot-xxxx.run.app/webhook/랜덤문자열
# WEBHOOK_SECRET=setWebhook의 secret_token (수신 헤더 검증값) — 영숫자·'_'·'-'만 허용, `openssl rand -hex 32`로 생성

# Firestore 프로젝트 (Cloud Run 에서는 메타데이터로 자동 인식)
# GOOGLE_CLOUD_PROJECT=my-project-id
# 로컬에서 Firestore 접근 시: 서비스 계정 키 파일 경로 (.gitignore 대상)
# GOOGLE_APPLICATION_CREDENTIALS=./ixibot.serviceaccount.json
